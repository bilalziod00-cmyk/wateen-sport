{
  "name": "wateen-sport",
  "version": "1.0.0",
  "private": true,
  "description": "وتين سبورت - تطبيق أخبار وبطولات ونتائج الرياضة الأردنية مع لوحة تحكم إدارية ومزامنة سحابية وتصدير APK لأندرويد",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync android",
    "cap:open": "npx cap open android",
    "android:apk:debug": "npm run cap:sync && cd android && gradlew assembleDebug",
    "android:apk:release": "npm run cap:sync && cd android && gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/share": "^6.0.2",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2",
    "firebase": "^11.0.2",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
