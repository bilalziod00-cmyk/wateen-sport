rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // الصور والوسائط العامة المنشورة في التطبيق
    match /wateen_media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin()
                   && request.resource.size < 10 * 1024 * 1024;
    }

    // ملفات المصادر الأصلية لعمليات الاستيراد الذكي (JPG, PNG, PDF, XLSX, CSV)
    match /wateen_imports/{batchId}/{fileName} {
      allow read, write: if isAdmin()
                         && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
