# انسخ هذا الملف إلى: firebase/functions/.env قبل النشر (لا ترفع ملف .env الفعلي إلى Git)
# يقرأ محرك WATEEN AI على الخادم (wateenAiCore.js) المفتاح حسب المزود المختار من لوحة التحكم

# إذا كنت تستخدم OpenAI (مثل gpt-4o-mini):
OPENAI_API_KEY=

# إذا كنت تستخدم Google Gemini (مثل gemini-2.0-flash):
GEMINI_API_KEY=
