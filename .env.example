# إعدادات Firebase السحابية لتطبيق وتين سبورت (مشروع wateen-sport-app)
# انسخ هذا الملف إلى .env واملأ قيم مشروع wateen-sport-app من Firebase Console أو ارفع ملف google-services.json من داخل لوحة التحكم

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=wateen-sport-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=wateen-sport-app
VITE_FIREBASE_STORAGE_BUCKET=wateen-sport-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# الرمز السري الافتراضي للوحة تحكم المالك (يمكن تغييره أيضاً من داخل التطبيق)
VITE_DEFAULT_ADMIN_PIN=2026
